# Use a restricted, NON-OWNER role for the application.
OCEAN_DATABASE_URL=postgresql://ocean_app:LOCAL_DEV_ONLY@127.0.0.1:5432/ocean_cloud
# Use a separate migration/owner role for schema changes.
OCEAN_MIGRATION_DATABASE_URL=postgresql://postgres:LOCAL_DEV_ONLY@127.0.0.1:5432/ocean_cloud
PORT=8080
# Must be explicitly enabled during approved onboarding/UAT, disabled by default.
OCEAN_SIGNUP_ENABLED=false
NODE_ENV=development

# MFA has a separate 32-byte random key; inject only through secret manager.
OCEAN_MFA_KEY_HEX=
# Controlled synthetic enrollment only; never enabled in production.
OCEAN_MFA_UAT_ENABLED=false
