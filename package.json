{
  "name": "@aig/ocean-cloud-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "db:migrate": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
